<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#F5F0FF">

    <Button
        android:id="@+id/btnDialLoad"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Load Contacts"
        android:backgroundTint="#C9B8E8"
        android:textColor="#FFFFFF"
        app:cornerRadius="12dp" />

    <Button
        android:id="@+id/btnDialSync"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Sync to Vault"
        android:backgroundTint="#D90A56"
        android:textColor="#FFFFFF"
        android:layout_marginTop="8dp"
        app:cornerRadius="12dp" />

    <EditText
        android:id="@+id/etVaultSearch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Search by name or number"
        android:backgroundTint="#695099"
        android:layout_marginTop="12dp"
        android:paddingStart="8dp" />

    <Button
        android:id="@+id/btnVaultLookup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Search Vault"
        android:backgroundTint="#88F8C4"
        android:textColor="#FFFFFF"
        android:layout_marginTop="8dp"
        app:cornerRadius="12dp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/dialRingList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="12dp" />

</LinearLayout>